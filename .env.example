# fingrr environment variables
# Copy to .env.local and fill in values.
# Prefix with EXPO_PUBLIC_ to expose to the app bundle.

# Push relay-lite URL (deploy server/ to fly.io or Railway)
EXPO_PUBLIC_PUSH_RELAY_URL=https://fingrr-push.fly.dev

# Shared secret between app and relay (set same value in fly secrets set RELAY_SECRET=...)
EXPO_PUBLIC_PUSH_RELAY_SECRET=

# ATProto PDS to use for new account creation (optional — defaults to bsky.social)
# EXPO_PUBLIC_DEFAULT_PDS=https://bsky.social
