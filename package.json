{
  "name": "fingrr",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "electron:dev": "concurrently \"expo start --web\" \"wait-on http://127.0.0.1:8081 && electron .\"",
    "electron:export": "expo export --platform web",
    "electron:build": "npm run electron:export && electron-builder --config electron-builder.yml",
    "electron:build:win": "npm run electron:export && electron-builder --config electron-builder.yml --win",
    "electron:build:mac": "npm run electron:export && electron-builder --config electron-builder.yml --mac",
    "electron:build:linux": "npm run electron:export && electron-builder --config electron-builder.yml --linux"
  },
  "dependencies": {
    "@atproto/api": "^0.13.0",
    "@atproto/oauth-client-browser": "^0.5.10",
    "@expo/metro-runtime": "~4.0.1",
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "bs58": "^6.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.0",
    "expo-dev-client": "~5.0.20",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-modules-core": "~2.2.3",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.24",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-native-webrtc": "^124.0.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-transform-class-static-block": "^8.0.5",
    "@testing-library/react-native": "12.7.2",
    "@types/react": "~18.3.12",
    "babel-jest": "^29.7.0",
    "concurrently": "^10.0.6",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "jest": "^29.7.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.0",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "@babel/runtime": ">=7.26.10",
    "postcss": ">=8.5.23",
    "query-string": "^7.1.3"
  }
}
